# Copy this file to .env and fill in real values. Never commit .env itself.

# --- App ---
APP_NAME=Agni AI Backend
APP_ENV=development
DEBUG=True

# --- CORS ---
# Comma-separated list of allowed origins for local frontend dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Local Postgres connection used by SQLAlchemy + Alembic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agni_ai_dev

# Full URL is assembled from the above at runtime, but you can override it directly:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agni_ai_dev
