# Copy to .env (platform settings) and .env.local (voice-provider keys). Never commit either.

# ---------------- App ----------------
APP_NAME=Agni AI Backend
APP_ENV=development            # production/staging enables the startup safety checks below
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.13:5173

# ---------------- Database (PostgreSQL) ----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agni_ai_dev
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agni_ai_dev

# ---------------- Security (REQUIRED when APP_ENV != development) ----------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-key
# Shared secret Exotel/LiveKit must send to /inbound/webhook and /telephony/exotel/status
INBOUND_WEBHOOK_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# Server-to-server secret the voice agent sends (X-Agent-Secret) to /appointments/agent
AGENT_INTERNAL_SECRET=
# If set, /stt/stream requires ?token=... (the agent subprocess adds it automatically)
STT_INTERNAL_TOKEN=
CHAT_RATE_LIMIT_PER_MINUTE=20

# ---------------- Billing ----------------
CREDITS_PER_MINUTE=1.0
DEFAULT_SIGNUP_CREDITS=10
MIN_CREDITS_TO_CALL=0

# ---------------- Background workers (campaign dialer + webhook delivery) ----------------
# Dev: True runs them inside the API. Production: False here, and run  python -m app.workers.run
RUN_BACKGROUND_WORKERS=False
DIALER_INTERVAL_SECONDS=5
WEBHOOK_INTERVAL_SECONDS=3
WEBHOOK_MAX_ATTEMPTS=6

# ---------------- Telephony ----------------
TELEPHONY_PROVIDER=mock        # mock | exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_WEBHOOK_BASE_URL=       # public https URL of THIS API, e.g. https://api.yourdomain.com
EXOTEL_FLOW_URL=               # Exotel Voice flow that bridges the answered call to LiveKit SIP

# ---------------- Voice pipeline (.env.local) ----------------
AVAILABLE_LLM_MODELS=          # comma list shown by GET /models; empty = just OPENAI_MODEL
# OPENAI_API_KEY=
# OPENAI_MODEL=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# One ELEVENLABS_VOICE_ID_* per voice in app/voice/voice_registry.py

LOG_LEVEL=INFO
